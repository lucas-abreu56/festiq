# Spotify Web API Credentials
# Obtenha em: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=seu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_spotify_client_secret_aqui

# Last.fm API Key (Opcional - Chave pública do Audioscrobbler inclusa como fallback)
# Obtenha uma chave própria gratuitamente em: https://www.last.fm/api/account/create
LASTFM_API_KEY=sua_lastfm_api_key_aqui

# URL da Aplicação (usada no redirect OAuth — Spotify exige 127.0.0.1 em vez de localhost)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
